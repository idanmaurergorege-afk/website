# Copy to .env.local and fill in whichever keys you have. All are optional —
# every category works with manual entry if you skip this file entirely.
# See README.md for what each key unlocks and where to get it for free.

# Stocks/ETFs — free, instant signup: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# Precious metals spot prices (paid): https://metals-api.com/
METALS_API_KEY=

# Real estate AVM (paid): https://www.rentcast.io/api
REALESTATE_API_KEY=

# Real estate index-estimate fallback — free, instant signup:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Watch market price lookups via your own Apify actor (optional, ToS risk is yours): https://apify.com/
WATCH_DATA_API_KEY=

# VIN-based car valuation (paid): https://www.marketcheck.com/apis
CAR_DATA_API_KEY=
